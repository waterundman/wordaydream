{
  "name": "wordaydream",
  "private": true,
  "version": "3.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:harmony": "vite build --mode harmony && node scripts/verify-harmony-build.mjs",
    "build:harmony:hap": "npm run build:harmony && node scripts/assemble-harmony-hap.mjs",
    "verify:harmony-build": "node scripts/verify-harmony-build.mjs",
    "verify:wordlists": "node scripts/verify-wordlists.mjs",
    "verify:static-assets": "node scripts/optimize-static-assets.mjs --check",
    "optimize:static-assets": "node scripts/optimize-static-assets.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "test:harmony-build-verifier": "node --test scripts/verify-harmony-build.test.mjs",
    "test:harmony-build-wrapper": "node --test scripts/hvigor-output.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e:web": "playwright test --project=chromium e2e/web.spec.ts",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-alignment.mjs"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.5.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "jsonrepair": "^3.15.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "fake-indexeddb": "^5.0.2",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "lighthouse": "^11.0.0",
    "oxlint": "^1.71.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
