# ============================================
# Wordaydream Harmony LLM Proxy 环境变量 (TEMPLATE)
# ============================================
# 复制本文件为 .env, 填入 API key 后启动:
#   cp .env.example .env
#   node llm-proxy.js
#
# API key 仅由后端 process.env 持有, 前端 (ArkWeb) 永远看不到 key.

# LLM Provider API Keys (至少配置一个)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 监听端口 (默认 3001)
PORT=3001

# 附加允许的 CORS origin (逗号分隔, 可选)
# 默认已允许: http://localhost:* / http://127.0.0.1:* / arkweb://* / https://*.hapogo.com / file://
# CORS_ALLOWED_ORIGINS=https://my-custom-domain.com,https://staging.my-domain.com
